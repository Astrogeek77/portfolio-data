    "id": "order-processing-saga",
    "name": "Distributed Order Processing Saga",
    "summary": "Event-driven order workflows coordinated across independently deployable services.",
    "description": "Takes an order from API submission through Kafka events to inventory and payment services, coordinating completion or compensation while persisting workflow state in PostgreSQL.",
    "featured": true,
    "category": "Distributed systems",
    "status": "Featured system",
    "graphic": {
      "label": "EVENT-DRIVEN ORDER FLOW",
      "nodes": [
        "Order API",
        "Kafka",
        "Services",
        "State"
      ]
    },
    "problem": "Coordinate a multi-service order lifecycle while keeping each service independently deployable.",
    "architecture": [
      "Order API accepts a request and records the initial order state.",
      "Kafka carries lifecycle events between order, inventory, and payment services.",
      "Saga coordination supports choreography and orchestration patterns for workflow progression and compensation.",
      "Idempotent consumers make event retries and replays safer."
    ],
    "components": [
      {
        "name": "Order API",
        "role": "Accepts order requests and starts the workflow."
      },
      {
        "name": "Order Service",
        "role": "Owns order state and emits lifecycle events."
      },
      {
        "name": "Kafka",
        "role": "Transports order events between service boundaries."
      },
      {
        "name": "Inventory & Payment",
        "role": "Consume events and participate in saga progression."
      },
      {
        "name": "PostgreSQL",
        "role": "Persists service data and order state."
      }
    ],
    "techStack": [
      {
        "name": "Java",
        "role": "Service implementation"
      },
      {
        "name": "Spring Boot",
        "role": "HTTP APIs and application services"
      },
      {
        "name": "Apache Kafka",
        "role": "Event transport"
      },
      {
        "name": "PostgreSQL",
        "role": "Relational persistence"
      },
      {
        "name": "Docker",
        "role": "Containerized deployment"
      }
    ],
    "designNotes": [
      "Keep service ownership explicit and communicate through domain events.",
      "Make handlers idempotent so duplicate delivery does not repeat business effects.",
      "Model saga failure paths with compensating actions rather than assuming a distributed transaction."
    ],
