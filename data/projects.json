  {
    "id": "rag-pipeline",
    "name": "Production RAG Pipeline & Agentic Workflow",
    "summary": "A document-grounded retrieval pipeline built for low-latency LLM context assembly.",
    "description": "Turns uploaded PDFs into searchable context: PyMuPDF extracts and chunks text, FastEmbed creates vectors, and pgVector returns relevant passages to a FastAPI agent workflow.",
    "featured": true,
    "category": "AI & data engineering",
    "status": "Featured system",
    "graphic": {
      "label": "RETRIEVAL PIPELINE",
      "nodes": [
        "Documents",
        "Embeddings",
        "pgVector",
        "Context"
      ]
    },
    "problem": "Turn source documents into relevant, retrievable context for question answering and agent workflows.",
    "architecture": [
      "Ingestion extracts PDF text with PyMuPDF and splits it into retrieval-sized chunks.",
      "FastEmbed creates vectors that are stored with document metadata in PostgreSQL pgVector.",
      "A query is embedded and matched by vector similarity to retrieve relevant chunks.",
      "Retrieved context is returned to the LLM or agent workflow for response generation."
    ],
    "components": [
      {
        "name": "Document ingestion",
        "role": "Receives documents and coordinates parsing and indexing."
      },
      {
        "name": "PyMuPDF",
        "role": "Extracts text from PDF documents."
      },
      {
        "name": "Chunker & FastEmbed",
        "role": "Creates retrieval chunks and vector embeddings."
      },
      {
        "name": "PostgreSQL + pgVector",
        "role": "Stores vectors and performs similarity retrieval."
      },
      {
        "name": "FastAPI + Uvicorn",
        "role": "Serves ingestion and retrieval endpoints."
      },
      {
        "name": "LLM / agent workflow",
        "role": "Consumes retrieved context to produce a grounded result."
      }
    ],
    "techStack": [
      {
        "name": "Python",
        "role": "Pipeline implementation"
      },
      {
        "name": "FastAPI",
        "role": "Ingestion and retrieval API"
      },
      {
        "name": "Uvicorn",
        "role": "ASGI server"
      },
      {
        "name": "PyMuPDF",
        "role": "PDF text extraction"
      },
      {
        "name": "FastEmbed",
        "role": "Text embeddings"
      },
      {
        "name": "PostgreSQL + pgVector",
        "role": "Vector storage and similarity search"
      }
    ],
    "designNotes": [
      "Separate document ingestion from query-time retrieval.",
      "Keep chunk metadata alongside embeddings so retrieved context can be traced to its source.",
      "Optimize the retrieval path to return a compact context set for downstream generation."
    ],
    "flow": [
      "PDF documents",
      "PyMuPDF extraction",
      "Chunking",
      "FastEmbed vectors",
      "pgVector index",
      "Similarity search",
      "LLM / agent context"
    ],
